{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sample ecommerce - Recommended option, generated by Cloud Recommender",
  "Parameters": {
    "LatestAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample ecommerce vpc"
          }
        ]
      }
    },
    "Igw": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "IgwAttach": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "IgwAttach",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample ecommerce public A"
          }
        ]
      }
    },
    "PublicAssocA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetA"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PrivateSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.10.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample ecommerce private A"
          }
        ]
      }
    },
    "PublicSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample ecommerce public B"
          }
        ]
      }
    },
    "PublicAssocB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetB"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PrivateSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample ecommerce private B"
          }
        ]
      }
    },
    "AlbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Load balancer: HTTP from the internet",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "InstanceSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Application servers",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourceSecurityGroupId": {
              "Ref": "AlbSg"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "DbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Database: PostgreSQL from the application servers only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "InstanceSg"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "DbSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private subnets for the database",
        "SubnetIds": [
          {
            "Ref": "PrivateSubnetA"
          },
          {
            "Ref": "PrivateSubnetB"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Delete",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": "db.t3.large",
        "AllocatedStorage": "30",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": false,
        "MasterUsername": "dbadmin",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DbSubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSg"
          }
        ],
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": 1,
        "DeletionProtection": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
          "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": {
            "Ref": "LatestAmiId"
          },
          "InstanceType": "m5.large",
          "IamInstanceProfile": {
            "Arn": {
              "Fn::GetAtt": [
                "InstanceProfile",
                "Arn"
              ]
            }
          },
          "SecurityGroupIds": [
            {
              "Ref": "InstanceSg"
            }
          ],
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeSize": 34,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ],
          "MetadataOptions": {
            "HttpTokens": "required"
          },
          "UserData": {
            "Fn::Base64": "#!/bin/bash\ndnf install -y nginx amazon-cloudwatch-agent\ncat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF'\n{\"metrics\":{\"metrics_collected\":{\"mem\":{\"measurement\":[\"mem_used_percent\"]},\"disk\":{\"measurement\":[\"used_percent\"],\"resources\":[\"/\"]}}}}\nEOF\n/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s\necho \"<h1>Sample ecommerce</h1><p>Deployed by Cloud Recommender</p>\" > /usr/share/nginx/html/index.html\nsystemctl enable --now nginx\n"
          },
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Sample ecommerce"
                },
                {
                  "Key": "ProjectId",
                  "Value": "6af88e13811bc30b42bf447b"
                },
                {
                  "Key": "ManagedBy",
                  "Value": "cloud-recommender"
                },
                {
                  "Key": "Name",
                  "Value": "Sample ecommerce server"
                }
              ]
            },
            {
              "ResourceType": "volume",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Sample ecommerce"
                },
                {
                  "Key": "ProjectId",
                  "Value": "6af88e13811bc30b42bf447b"
                },
                {
                  "Key": "ManagedBy",
                  "Value": "cloud-recommender"
                }
              ]
            }
          ]
        }
      }
    },
    "Asg": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "DependsOn": "PublicRoute",
      "Properties": {
        "MinSize": "3",
        "MaxSize": "3",
        "DesiredCapacity": "3",
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "LaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "LaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "VPCZoneIdentifier": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetB"
          }
        ],
        "HealthCheckType": "ELB",
        "HealthCheckGracePeriod": 300,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce",
            "PropagateAtLaunch": true
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b",
            "PropagateAtLaunch": true
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender",
            "PropagateAtLaunch": true
          }
        ],
        "TargetGroupARNs": [
          {
            "Ref": "TargetGroup"
          }
        ]
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "DependsOn": "IgwAttach",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "SecurityGroups": [
          {
            "Ref": "AlbSg"
          }
        ],
        "Subnets": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetB"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "instance",
        "HealthCheckPath": "/",
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample ecommerce"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447b"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "CpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Average CPU above 80% for 10 minutes",
        "Namespace": "AWS/EC2",
        "MetricName": "CPUUtilization",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "Dimensions": [
          {
            "Name": "AutoScalingGroupName",
            "Value": {
              "Ref": "Asg"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "AutoScalingGroup": {
      "Value": {
        "Ref": "Asg"
      }
    },
    "LoadBalancerDNS": {
      "Value": {
        "Fn::GetAtt": [
          "Alb",
          "DNSName"
        ]
      }
    },
    "DatabaseEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    }
  }
}