{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sample video - High performance option, generated by Cloud Recommender",
  "Parameters": {
    "LatestAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample video vpc"
          }
        ]
      }
    },
    "Igw": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "IgwAttach": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "IgwAttach",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample video public A"
          }
        ]
      }
    },
    "PublicAssocA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetA"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PublicSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          },
          {
            "Key": "Name",
            "Value": "Sample video public B"
          }
        ]
      }
    },
    "PublicAssocB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetB"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "AlbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Load balancer: HTTP from the internet",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "InstanceSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Application servers",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourceSecurityGroupId": {
              "Ref": "AlbSg"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
          "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ],
        "Policies": [
          {
            "PolicyName": "BucketAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "DataBucket",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": {
            "Ref": "LatestAmiId"
          },
          "InstanceType": "c5.2xlarge",
          "IamInstanceProfile": {
            "Arn": {
              "Fn::GetAtt": [
                "InstanceProfile",
                "Arn"
              ]
            }
          },
          "SecurityGroupIds": [
            {
              "Ref": "InstanceSg"
            }
          ],
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeSize": 30,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ],
          "MetadataOptions": {
            "HttpTokens": "required"
          },
          "UserData": {
            "Fn::Base64": "#!/bin/bash\ndnf install -y nginx amazon-cloudwatch-agent\ncat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF'\n{\"metrics\":{\"metrics_collected\":{\"mem\":{\"measurement\":[\"mem_used_percent\"]},\"disk\":{\"measurement\":[\"used_percent\"],\"resources\":[\"/\"]}}}}\nEOF\n/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s\necho \"<h1>Sample video</h1><p>Deployed by Cloud Recommender</p>\" > /usr/share/nginx/html/index.html\nsystemctl enable --now nginx\n"
          },
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Sample video"
                },
                {
                  "Key": "ProjectId",
                  "Value": "6af88e13811bc30b42bf447d"
                },
                {
                  "Key": "ManagedBy",
                  "Value": "cloud-recommender"
                },
                {
                  "Key": "Name",
                  "Value": "Sample video server"
                }
              ]
            },
            {
              "ResourceType": "volume",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Sample video"
                },
                {
                  "Key": "ProjectId",
                  "Value": "6af88e13811bc30b42bf447d"
                },
                {
                  "Key": "ManagedBy",
                  "Value": "cloud-recommender"
                }
              ]
            }
          ]
        }
      }
    },
    "Asg": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "DependsOn": "PublicRoute",
      "Properties": {
        "MinSize": "3",
        "MaxSize": "3",
        "DesiredCapacity": "3",
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "LaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "LaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "VPCZoneIdentifier": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetB"
          }
        ],
        "HealthCheckType": "ELB",
        "HealthCheckGracePeriod": 300,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video",
            "PropagateAtLaunch": true
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d",
            "PropagateAtLaunch": true
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender",
            "PropagateAtLaunch": true
          }
        ],
        "TargetGroupARNs": [
          {
            "Ref": "TargetGroup"
          }
        ]
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "DependsOn": "IgwAttach",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "SecurityGroups": [
          {
            "Ref": "AlbSg"
          }
        ],
        "Subnets": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetB"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "instance",
        "HealthCheckPath": "/",
        "Tags": [
          {
            "Key": "Project",
            "Value": "Sample video"
          },
          {
            "Key": "ProjectId",
            "Value": "6af88e13811bc30b42bf447d"
          },
          {
            "Key": "ManagedBy",
            "Value": "cloud-recommender"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "CpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Average CPU above 80% for 10 minutes",
        "Namespace": "AWS/EC2",
        "MetricName": "CPUUtilization",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "Dimensions": [
          {
            "Name": "AutoScalingGroupName",
            "Value": {
              "Ref": "Asg"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "AutoScalingGroup": {
      "Value": {
        "Ref": "Asg"
      }
    },
    "LoadBalancerDNS": {
      "Value": {
        "Fn::GetAtt": [
          "Alb",
          "DNSName"
        ]
      }
    },
    "BucketName": {
      "Value": {
        "Ref": "DataBucket"
      }
    }
  }
}